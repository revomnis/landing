{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap-knowledge.xml",
      "destination": "/api/sitemap-knowledge"
    },
    {
      "source": "/knowledge/:slug",
      "destination": "/api/knowledge-article?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
